# Supabase (Project Settings > API). Nunca coloque a service_role key aqui.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# IA usada pela função /api/generate (copiar sites e gerar por texto). Ordem de escolha:
# 1) ANTHROPIC_API_KEY (Claude oficial, pago)
# 2) Free Claude Code rodando no PC (gratuito; só no desenvolvimento local)
# 3) NVIDIA_API_KEY (gratuito, na nuvem; é o que roda no Vercel, mesma chave da Sexta-feira)
# Sem nenhuma: lê o site de verdade e monta por regras.
ANTHROPIC_API_KEY=
FCC_URL=http://127.0.0.1:8082
FCC_TOKEN=
NVIDIA_API_KEY=
# Opcional: modelos da NVIDIA em ordem de preferência
# NVIDIA_MODELOS=nvidia/nemotron-3-ultra-550b-a55b,nvidia/nemotron-3.5-lightning-30b-a3b
# Opcional: PRIME_IA=nvidia força a NVIDIA mesmo com o Free Claude Code ligado
# Opcional: outro endpoint de geração (substitui /api/generate).
VITE_GENERATOR_ENDPOINT=
