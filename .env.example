# Supabase (Project Settings > API). Nunca coloque a service_role key aqui.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# IA (Claude) usada pela função /api/generate para copiar sites e gerar por texto.
# Só no servidor (Vercel > Settings > Environment Variables). Sem ela, o site lê o
# endereço de verdade e monta por regras, mas sem a IA reescrevendo e organizando.
ANTHROPIC_API_KEY=
# Opcional: outro endpoint de geração (substitui /api/generate).
VITE_GENERATOR_ENDPOINT=
